{
  "manifest_version": 3,
  "name": "YouTube Music — Rosé Pine Moon",
  "version": "1.2.0",
  "description": "A cleaner YouTube Music, themed with the Rosé Pine Moon palette.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmusic-rose-pine-moon@extensions",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "css": [
        "src/theme.css"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/visualizer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Rosé Pine Moon",
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon.svg"
  }
}
