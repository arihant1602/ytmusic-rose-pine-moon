{
  "name": "ytmusic-rose-pine-moon",
  "version": "1.2.0",
  "private": true,
  "description": "Firefox extension that reskins YouTube Music with the Ros\u00e9 Pine Moon palette.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "web-ext run",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "sign": "web-ext sign --channel=unlisted",
    "sign:listed": "web-ext sign --channel=listed --amo-metadata=amo-metadata.json"
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
